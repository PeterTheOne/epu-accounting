# Copy this file to `.env` and adjust the values for your local setup.
# The `.env` file is gitignored; never commit real local settings.

# Locale used by match_pdf.py to parse German month names in invoice PDFs.
# Check which locales are available on your OS with `locale -a`.
LOCALE=de_DE.utf8

# Own N26 account names (main account and all Spaces), comma-separated.
# clean_csv.py ignores N26 rows without IBAN whose partner name is one of these
# (money moved between own accounts). Fees, interest etc. are kept.
N26_OWN_ACCOUNTS=Hauptkonto,Main Account,Space1
